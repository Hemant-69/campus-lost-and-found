# PostgreSQL Pooled connection string (e.g., Neon or Supabase pooler / PgBouncer)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# PostgreSQL Direct connection string (used by Prisma migrations)
DIRECT_URL="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js secret key (generate with: openssl rand -base64 33)
AUTH_SECRET="your-32-character-secret-key-goes-here"

# Canonical application URL
AUTH_URL="http://localhost:3000"

# Bearer secret for authenticating Vercel Cron jobs
CRON_SECRET="your-random-cron-secret-token"
